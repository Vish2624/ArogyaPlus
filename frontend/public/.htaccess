# React Router uses client-side (HTML5 history) routing, so a direct request or refresh on a
# route like /admin has no matching file on the server. Fall back to index.html for anything
# that isn't a real file/directory, and let the app's router take it from there.
#
# Only known route prefixes (kept in sync with src/routes/AppRoutes.tsx) get the 200+index.html
# treatment. Anything else - old WordPress-era URLs from before this domain ran this app,
# typos, scanner noise - falls through to a real Apache 404 instead of a "soft 404" (200 with
# an SPA shell that only becomes noindex once React mounts and Helmet runs). Search engines
# discount/deprioritize soft-404 URLs and can end up treating the whole domain as low-quality;
# a genuine 404 status is the unambiguous signal. ErrorDocument below still serves the SPA
# shell so NotFoundPage renders with the site's real header/footer instead of Apache's default
# error page - only the HTTP status code differs from the old behavior.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^$ /index.html [L]
  RewriteRule ^(packages|tests|booking|privacy-policy|terms|admin)(/.*)?$ /index.html [L]
</IfModule>

ErrorDocument 404 /index.html

# Security headers. Scoped to what this app actually loads, verified against the source:
# - Fonts are self-hosted (@fontsource) - no fonts.googleapis.com/fonts.gstatic.com needed.
# - The API origin (VITE_API_BASE_URL) is the same origin as the site itself - no separate
#   API host needed in connect-src.
# - img-src allows any https: host (not just 'self'): the admin package/test/banner forms
#   have a plain "image_url" text field that explicitly accepts pasted external image URLs,
#   not just this app's own /uploads - a same-origin-only img-src would silently break that.
# - style-src needs 'unsafe-inline': React sets inline style="" attributes in a few places
#   (e.g. the search-autocomplete dropdown's computed position) and there's no nonce/hash
#   build pipeline here to avoid it. This is a known, common trade-off for CSP on apps using
#   inline styles without a CSS-in-JS nonce setup.
# - script-src intentionally does NOT need 'unsafe-inline': the JSON-LD blocks this app
#   renders (type="application/ld+json") are inert data, not executable script, so CSP's
#   script-src does not restrict them.
#
# IMPORTANT: verify this against a staging/preview deploy before relying on it in production -
# it was written from a source-code audit, not a live run of the deployed site, and a wrong
# CSP directive fails closed (breaks a real page) rather than failing open.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
